  "scenes": [
    {"id": "collection", "start": 0, "end": 6, "params": {"beat": "475 tiles rise in three waves and sort into skillry's four categories; one explainer tile lifts off"}},
    {"id": "brief", "start": 6, "end": 12, "params": {"beat": "the tile lands on the line as a brief; eight sections appear; each emits this film's requirements into hard/proxy/human bins; the bins freeze"}},
