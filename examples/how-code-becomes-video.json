  "requirements": [
    {"id": "DUR", "description": "Exactly 48 seconds", "kind": "hard", "metric": "duration_s", "op": "eq", "target": 48.0},
    {"id": "WIDTH", "description": "1920 pixels wide", "kind": "hard", "metric": "width_px", "op": "eq", "target": 1920},
    {"id": "HEIGHT", "description": "1080 pixels high", "kind": "hard", "metric": "height_px", "op": "eq", "target": 1080},
    {"id": "FPS", "description": "30 fps", "kind": "hard", "metric": "fps", "op": "eq", "target": 30},
    {"id": "FRAMES", "description": "Exactly 1440 encoded frames; no duplicated end frame", "kind": "hard", "metric": "encoded_frame_count", "op": "eq", "target": 1440},
    {"id": "PTS", "description": "Evenly spaced frame timestamps", "kind": "hard", "metric": "frame_timestamp_jitter_ms", "op": "le", "target": 1},
    {"id": "AUDIO", "description": "Original synthesized audio exists", "kind": "hard", "metric": "audio_present", "op": "eq", "target": true},
    {"id": "LOUD-MIN", "description": "Integrated loudness after AAC encode at least -17 LUFS", "kind": "hard", "metric": "integrated_loudness_lufs", "op": "ge", "target": -17},
    {"id": "LOUD-MAX", "description": "Integrated loudness after AAC encode at most -15 LUFS", "kind": "hard", "metric": "integrated_loudness_lufs", "op": "le", "target": -15},
    {"id": "TRUE-PEAK", "description": "True peak after AAC encode at most -1 dBTP", "kind": "hard", "metric": "true_peak_dbtp", "op": "le", "target": -1},
    {"id": "SEEK", "description": "Sampled renders unaffected by seek order (pixels and telemetry)", "kind": "hard", "metric": "determinism_mismatches", "op": "eq", "target": 0},
    {"id": "HITS", "description": "A detectable sound lands within 20 ms of every declared cue", "kind": "proxy", "metric": "audio_hit_sync_ms", "op": "le", "target": 20},
    {"id": "COPY", "description": "Every section headline appears in visible-text telemetry", "kind": "proxy", "metric": "text_present", "params": {"strings": ["475 videos, built by an AI that writes code.", "The prompt reads like a spec.", "Every frame is a function of t.", "A browser photographs every frame.", "Every sound lands by its peak.", "Then it measures what it rendered.", "A new visual idea every 1.8 seconds.", "Written as code.", "Measured as video."]}, "op": "eq", "target": true},
    {"id": "BANNED", "description": "Self-reported corpus claims stay out of the film", "kind": "proxy", "metric": "text_absent", "params": {"strings": ["zero-shot", "viral", "one prompt", "no human"]}, "op": "eq", "target": true},
    {"id": "FONT", "description": "All visible text at least 24 px at 1080p (16 px at 720p)", "kind": "proxy", "metric": "minimum_text_size_px", "op": "ge", "target": 24},
    {"id": "CONTRAST", "description": "Settled text colour vs rendered backing at least 4.5:1", "kind": "proxy", "metric": "minimum_contrast", "op": "ge", "target": 4.5},
    {"id": "SAFE", "description": "Text stays inside 5% margins (96 px sides, 54 px top/bottom)", "kind": "proxy", "metric": "safe_area_violations", "params": {"margins": [96, 54, 96, 54]}, "op": "eq", "target": 0},
    {"id": "OVERLAP", "description": "Outgoing text leaves before incoming text occupies its space", "kind": "proxy", "metric": "text_overlap_violations", "op": "eq", "target": 0},
    {"id": "HOLD", "description": "Every section headline stays readable and unchanged for at least 3 s", "kind": "proxy", "metric": "minimum_text_hold_s", "params": {"ids": ["headline-0", "headline-1", "headline-2", "headline-3", "headline-4", "headline-5", "headline-6", "headline-7"]}, "op": "ge", "target": 3.0},
    {"id": "DEAD-TIME", "description": "No decoded interval longer than 1.5 s without visible change", "kind": "proxy", "metric": "max_static_hold_s", "op": "le", "target": 1.5},
    {"id": "POPS", "description": "No one-frame flashes or jumps", "kind": "proxy", "metric": "single_frame_pops", "op": "eq", "target": 0},
    {"id": "GRID", "description": "Declared scene boundaries fall on the 120 BPM grid", "kind": "proxy", "metric": "beat_cut_error_ms", "op": "le", "target": 1},
    {"id": "CRAFT", "description": "Rich and readable at normal speed; every move grows out of the previous state", "kind": "human", "rubric": "Watch the full film with sound at normal speed, then compare it with the reference that motivated it. Is each station's mechanism understandable from the picture alone? Can every line be read without pausing? Does every camera move and transition come from the previous state? Do the sounds feel attached to what they mark? Cite timestamps; no proxy above answers this."},
    {"id": "TRUTH", "description": "Every number on screen traces to its source", "kind": "human", "rubric": "Check each on-screen number against this contract, the composition source and compositions/how-code-becomes-video/corpus.json / docs/OPUS_VIDEO_RESEARCH.md. Is any claim stated more strongly than its evidence label (Observed, Stated, Inferred)? Cite timestamps."}
