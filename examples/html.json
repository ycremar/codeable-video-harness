    {"id": "SAFE", "description": "Text stays inside 64 px side and 40 px top/bottom margins", "kind": "proxy", "metric": "safe_area_violations", "params": {"margins": [64, 40, 64, 40]}, "op": "eq", "target": 0},
    {"id": "OVERLAP", "description": "Outgoing text leaves before incoming text occupies its space", "kind": "proxy", "metric": "text_overlap_violations", "op": "eq", "target": 0},
    {"id": "DEAD-TIME", "description": "No decoded interval longer than 1.5 s without visible change", "kind": "proxy", "metric": "max_static_hold_s", "op": "le", "target": 1.5},
    {"id": "POPS", "description": "No one-frame flashes or jumps", "kind": "proxy", "metric": "single_frame_pops", "op": "eq", "target": 0},
    {"id": "GRID", "description": "Declared scene cuts fall on the 120 BPM grid", "kind": "proxy", "metric": "beat_cut_error_ms", "op": "le", "target": 1},
    {"id": "CRAFT", "description": "Each transition visibly comes from the previous state and the loop reads at normal speed", "kind": "human", "rubric": "Watch the full clip with sound at normal speed. Does every scene grow out of the previous one (no arbitrary crossfades)? Is each line readable without pausing? Do sounds feel attached to the motion they mark? Cite timestamps; proxies above cannot answer this."}
  ]
}
