    {"id": "COPY", "description": "Key lines appear in visible-text telemetry", "kind": "proxy", "metric": "text_present", "params": {"strings": ["One prompt.", "becomes a contract.", "Every frame is f(t).", "Repair what failed.", "Evidence, not vibes."]}, "op": "eq", "target": true},
    {"id": "FONT", "description": "All visible text at least 22 px", "kind": "proxy", "metric": "minimum_text_size_px", "op": "ge", "target": 22},
