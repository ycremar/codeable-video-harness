  "requirements": [
    {"id": "DUR", "description": "Exactly 12 seconds", "kind": "hard", "metric": "duration_s", "op": "eq", "target": 12.0},
    {"id": "W", "description": "1280 pixels wide", "kind": "hard", "metric": "width_px", "op": "eq", "target": 1280},
